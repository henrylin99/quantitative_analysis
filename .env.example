# Flask
DEBUG=True
SECRET_KEY=change-this-secret

# SQLite ORM default
SQLITE_DATABASE_PATH=./instance/stock_cursor.sqlite3

# Data source
DATA_SOURCE=parquet
TUSHARE_TOKEN=your_tushare_token

# 第三方行情数据源（与 tushare 相互独立，同一张 Parquet 表的可选生产者）
# 扶摇（同花顺）：日线/财务/实时快照，daily_history_fuyao 等任务使用
FUYAO_API_KEY=
# TickFlow：free 档仅支持单标的日K/行情（约5rpm），仅作校验兜底，勿用于批量任务
TICKFLOW_API_KEY=

# Runtime mode
DATA_JOB_EXECUTION_MODE=inline

# AI 智能工作台（OpenAI 兼容接口，DeepSeek / 通义 / GLM / Kimi / OpenAI / Ollama 均可）
# DeepSeek 示例：
#   LLM_API_KEY=sk-xxxx
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
# 本地 Ollama 示例（无需 API Key）：
#   LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=qwen2.5:14b
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 流式对话调优（可选）
# LLM_TIMEOUT=120
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=4096
# AI_MAX_TOOL_ITERATIONS=10

# Text2SQL 旧版 LLM 服务（provider 可选 ollama / openai）
LLM_PROVIDER=openai

# API 数据面门禁：设置后所有 /api/* 请求（含 GET）必须携带
# X-API-Token 头或 Authorization: Bearer <token>；留空表示不启用（本机单人使用）。
# 生产环境强制要求设置（>=16 位随机串），浏览器直连请由反向代理注入该头。
API_AUTH_TOKEN=

# 跨域来源：生产环境必须指定具体来源（如 https://your-domain.com），
# 生产配置校验会拒绝 '*' 或留空
# CORS_ORIGINS=http://localhost:5173

# Text2SQL 虚拟表单次加载行数上限（日期范围查询超限时保留最近的数据）
# TEXT2SQL_MAX_LOAD_ROWS=500000
